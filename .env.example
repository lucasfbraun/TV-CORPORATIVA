# Modelo de variáveis de ambiente. Copie para um arquivo chamado .env e preencha.
# Chave gratuita do GNews (https://gnews.io) para imagens nas notícias:
TV_NEWS_API_KEY=

# Token de API do Cloudflare, usado pelo Caddy para emitir certificado HTTPS
# público (Let's Encrypt) via validação DNS-01 na zona grupoflexivel.com.br.
# Crie em https://dash.cloudflare.com/profile/api-tokens com o template
# "Edit zone DNS", restrito à zona grupoflexivel.com.br. Veja
# docs/HTTPS_CONTINUACAO.md para o passo a passo completo.
CF_API_TOKEN=

# Active Directory / LDAP (login integrado) — valores iniciais, usados só na
# primeira execução para semear a configuração no banco. Depois disso, ajuste
# pela tela de admin (Sistema > LDAP / Active Directory) — o banco manda.
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_TLS=false
LDAP_DOMAIN=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
