# Modelo de variáveis de ambiente. Copie para um arquivo chamado .env e preencha.
# Chave gratuita do GNews (https://gnews.io) para imagens nas notícias:
TV_NEWS_API_KEY=

# Active Directory / LDAP (login integrado) — valores iniciais, usados só na
# primeira execução para semear a configuração no banco. Depois disso, ajuste
# pela tela de admin (Sistema > LDAP / Active Directory) — o banco manda.
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_TLS=false
LDAP_DOMAIN=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# ── Desempenho (opcional — os padroes ja servem) ──────────────────────────────
# Threads do servidor web (padrao 16; o waitress sozinho usaria 4).
TV_THREADS=16
# Conexoes maximas no pool do Postgres. Deve ficar ACIMA de TV_THREADS.
TV_DB_POOL_MAX=24
# Cache em disco da midia, em data/media-cache. Use 0 para desligar.
# A pasta e descartavel: apagar so faz o proximo acesso rebuscar do banco.
TV_MEDIA_CACHE=1
